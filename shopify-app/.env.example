# Copy to .env. Leave Partner secrets empty until Austin creates the app.
# Do not invent SHOPIFY_API_KEY or SHOPIFY_API_SECRET.

DATABASE_URL="file:./dev.db"
DEMO_FIXTURE_SHOP=1
SCOPES=read_orders,read_products,read_customers
SHOPIFY_APP_URL=http://127.0.0.1:44731
PORT=44731

# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=

# Live storefront for Playwright (Partner Dawn store)
# SHOP_STOREFRONT_URL=https://your-store.myshopify.com
# SHOP_STOREFRONT_PASSWORD=
# SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# AGENTS_HEADED=0

# One-click storefront actions (Insights → Deploy to storefront)
# The agent that drafts each fix is Claude. Unset → template fixes only.
# ANTHROPIC_API_KEY=
# SYNDICATE_LLM_MODEL=claude-opus-5
# Demo fixture shop only: a custom-app Admin token (write_products) for the
# Dawn store the shoppers browse. Unset → deploys are simulated and labelled.
# SHOPIFY_ADMIN_ACCESS_TOKEN=
