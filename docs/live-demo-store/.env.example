# Harbour Run — live demo store (copy into Syndicate app .env; do not commit secrets)
# Old harbour-athletic-demo is superseded.

# Storefront (Playwright target). Prefer password disabled on the development store.
SHOP_STOREFRONT_URL=https://harbour-run-demo.myshopify.com

# Admin domain (no https://)
SHOPIFY_STORE_DOMAIN=harbour-run-demo.myshopify.com

# SEED TOOL ONLY — separate custom app with write_orders / write_customers / read_products
# Do NOT put this token on the Syndicate (read-only) app.
SHOPIFY_SEED_ADMIN_TOKEN=

# Syndicate runtime — prefer live orders from this store
USE_ORDER_FIXTURES=0
SYNDICATE_LLM_PROVIDER=off
AGENTS_AUTO_RUN=false

# Optional: storefront password if you keep the coming-soon gate
# SHOP_STOREFRONT_PASSWORD=
